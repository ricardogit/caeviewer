# CAE Viewer — Production Environment Configuration
#
# Copy this file to .env.production and fill in the values for your deployment.
# Never commit .env.production to git (add to .gitignore).

# ===== FLASK CONFIGURATION =====

# Environment mode
FLASK_ENV=production

# Secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# MUST be different for each deployment
SECRET_KEY=your-secret-key-here-generate-with-secrets-module

# Port Flask runs on (behind reverse proxy, typically not exposed directly)
API_PORT=8080

# ===== DATABASE =====

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# Examples:
#   - Local: postgresql://postgres:password@localhost:5432/caedb
#   - AWS RDS: postgresql://admin:password@caedb.abc123.us-east-1.rds.amazonaws.com:5432/caedb
#   - GCP Cloud SQL: postgresql://postgres:password@/caedb?host=/cloudsql/project:region:instance
#   - Azure: postgresql://admin@servername:password@servername.postgres.database.azure.com:5432/caedb
DATABASE_URL=postgresql://postgres:password@localhost:5432/caedb

# Database connection pool size (default: 10)
SQLALCHEMY_POOL_SIZE=10

# Max connections to wait in queue (default: 10)
SQLALCHEMY_MAX_OVERFLOW=10

# ===== CORS & SECURITY =====

# Allowed origins for CORS (comma-separated)
# Examples:
#   - Single domain: https://caeviewer.example.com
#   - Multiple: https://caeviewer.example.com,https://app.example.com
#   - Development: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=https://caeviewer.example.com

# Require HTTPS for CORS (set to false only for development)
CORS_ALLOW_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# ===== FILE UPLOADS =====

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=500

# Upload directory (should be writable by Flask process)
# Examples:
#   - Local: /var/cae-viewer/uploads
#   - Docker: /app/uploads
#   - S3: s3://bucket-name/uploads (if using S3 integration)
UPLOAD_DIR=/var/cae-viewer/uploads

# Cleanup old uploads after N days (0 = disabled)
UPLOAD_CLEANUP_DAYS=30

# ===== SOLVER CONFIGURATION =====

# FEM solver timeout (seconds)
SOLVER_TIMEOUT_SECONDS=3600

# Maximum mesh size per tier
# Tier 0: 30K DOF
# Tier 1: 600K DOF
# Tier 2: 6M DOF
# Tier 3: 60M DOF
SOLVER_TIER_LIMITS=30000,600000,6000000,60000000

# Default mesh refinement tolerance (adaptive solving)
SOLVER_REFINEMENT_TOLERANCE=0.05

# GMSH executable path (for geometry meshing)
# Examples:
#   - Linux: /usr/bin/gmsh
#   - macOS: /usr/local/bin/gmsh
#   - Docker: /usr/bin/gmsh (already installed)
GMSH_PATH=/usr/bin/gmsh

# ===== LOGGING & MONITORING =====

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=/var/log/cae-viewer/app.log

# Enable detailed solver logging (set to true for debugging)
SOLVER_DEBUG=false

# Sentry DSN (error tracking) — get from sentry.io
# Leave empty to disable
SENTRY_DSN=

# Prometheus metrics enabled (set to true to expose /metrics endpoint)
PROMETHEUS_ENABLED=false

# ===== REDIS (Optional) =====
# Uncomment if using Redis for caching or session storage

# Redis connection string
# REDIS_URL=redis://localhost:6379/0

# Cache timeout (seconds)
# CACHE_TIMEOUT=3600

# ===== EMAIL (Optional) =====
# Uncomment if implementing email notifications

# SMTP server
# MAIL_SERVER=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
# MAIL_PORT=587

# SMTP credentials
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# From address for emails
# MAIL_FROM=noreply@caeviewer.example.com

# ===== AUTHENTICATION (Optional) =====
# Uncomment if implementing user authentication

# OAuth provider (google, github, etc)
# AUTH_PROVIDER=google

# OAuth client ID and secret (get from provider console)
# AUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# AUTH_CLIENT_SECRET=your-client-secret

# Session timeout (minutes)
# SESSION_TIMEOUT=60

# ===== ADVANCED =====

# Number of worker threads for async tasks
WORKER_THREADS=4

# Enable profiling (only for debugging, impacts performance)
PROFILE_ENABLED=false

# Compression level for responses (0-9, 0=disabled)
COMPRESS_LEVEL=6

# SQLite fallback (if PostgreSQL unavailable) — NOT RECOMMENDED for production
# SQLALCHEMY_DATABASE_URI=sqlite:////var/cae-viewer/caedb.sqlite

# ===== DEPLOYMENT NOTES =====
#
# 1. Generate SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 2. Create directories:
#    mkdir -p /var/cae-viewer/uploads
#    mkdir -p /var/log/cae-viewer
#    chown app-user:app-user /var/cae-viewer /var/log/cae-viewer
#
# 3. Initialize database:
#    flask db upgrade
#
# 4. Test database connection:
#    python -c "from app import create_app; app = create_app(); print(app.config['SQLALCHEMY_DATABASE_URI'])"
#
# 5. Start Flask:
#    gunicorn -w 4 -b 0.0.0.0:8080 "app:create_app()"
#
# 6. Run migrations on each deployment:
#    flask db upgrade  (before restarting Flask)
#
# 7. Verify Sentry (if enabled):
#    curl -X GET "https://sentry.io/api/0/projects/org/project/" -H "Authorization: Bearer token"
#
# 8. Check logs:
#    tail -f /var/log/cae-viewer/app.log
