# CAE Viewer — Variables de entorno
# Copia a .env en el VPS y edita cada valor.
# NUNCA subas .env al repositorio.

# ─── Base de datos ─────────────────────────────────────────────────────────
DB_USER=caeviewer
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_NAME=caedb

DATABASE_URL=postgresql://caeviewer:CAMBIA_ESTA_CLAVE@postgres/caedb

# ─── Flask ─────────────────────────────────────────────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REEMPLAZA_CON_CLAVE_GENERADA

FLASK_ENV=production

# ─── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500

# ─── Puerto externo (cambia si hay conflicto) ───────────────────────────────
CAE_PORT=8080

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
