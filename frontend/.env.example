# STEP-View Pro Frontend Configuration

# API Base URL
VITE_API_BASE_URL=http://localhost:5000

# Draco Decoder Configuration
# Path to Draco decoder files (relative to public/ or absolute URL)
VITE_DRACO_DECODER_PATH=/draco/

# Enable/disable Draco compression
VITE_ENABLE_DRACO=true

# Development Mode
VITE_DEV_MODE=true
